# ============================================================
# .env.example — sao chép thành .env rồi điền giá trị thật.
# .env đã được .gitignore -> KHÔNG BAO GIỜ lên GitHub.
# Tự kiểm: `git ls-files | grep .env` phải RỖNG.
# ============================================================

# ---------- BACKEND (FastAPI) — chỉ ở máy chủ, tuyệt đối không ra frontend ----------
# Lấy ở Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# service_role = TOÀN QUYỀN database. Chỉ để ở backend/.env. KHÔNG bao giờ lộ.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# JWT secret để xác thực vé đăng nhập (Settings -> API -> JWT secret).
# Bỏ trống = chạy chế độ MỞ (không yêu cầu đăng nhập) — tiện demo.
SUPABASE_JWT_SECRET=

# CORS: các origin được phép gọi API (cách nhau bằng dấu phẩy).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sentry (buổi 3, tuỳ chọn). Bỏ trống = tắt.
SENTRY_DSN=

# ---------- FRONTEND (Vite) — biến có tiền tố VITE_ sẽ nhúng vào bundle web ----------
# anon/publishable key: AN TOÀN để công khai (RLS bảo vệ ở tầng DB).
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
# Bỏ trống = app chạy chế độ demo (không hiện nút đăng nhập Google).
VITE_SENTRY_DSN=

# ---------- LOCAL DEV (tuỳ chọn) ----------
# Đường dẫn file SQLite để giữ dữ liệu giữa các lần chạy (mặc định in-memory).
# SQLITE_PATH=./local.sqlite

# Google Analytics 4 (tuỳ chọn) — Measurement ID dạng G-XXXXXXX
VITE_GA_MEASUREMENT_ID=
